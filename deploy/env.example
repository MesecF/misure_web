# Settings for the container on the server. Create /opt/misure/misure.env from this, fill in
# and keep it readable only by root: chmod 600. Never commit the filled-in file.

# Long random value, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False

# Testing without a reverse proxy, opened as http://10.24.131.36:8084
DJANGO_ALLOWED_HOSTS=10.24.131.36
DJANGO_HTTPS=False
# With a domain behind the reverse proxy (HTTPS), instead:
# DJANGO_ALLOWED_HOSTS=misure.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://misure.example.com
# DJANGO_HTTPS=True
# Browsers then use only HTTPS for this host; default 86400 (a day), later 31536000 (a year)
# DJANGO_HSTS_SECONDS=86400

POSTGRES_HOST=10.24.131.35
POSTGRES_PORT=5432
POSTGRES_DB=misure
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
